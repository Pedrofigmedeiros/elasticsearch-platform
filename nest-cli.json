{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/elasticsearch-platform/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/elasticsearch-platform/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/elasticsearch-platform",
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json"
      }
    },
    "config": {
      "type": "library",
      "root": "libs/config",
      "entryFile": "index",
      "sourceRoot": "libs/config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/config/tsconfig.lib.json"
      }
    },
    "elasticsearch": {
      "type": "library",
      "root": "libs/elasticsearch",
      "entryFile": "index",
      "sourceRoot": "libs/elasticsearch/src",
      "compilerOptions": {
        "tsConfigPath": "libs/elasticsearch/tsconfig.lib.json"
      }
    },
    "elasticsearch-platform": {
      "type": "application",
      "root": "apps/elasticsearch-platform",
      "entryFile": "main",
      "sourceRoot": "apps/elasticsearch-platform/src",
      "compilerOptions": {
        "tsConfigPath": "apps/elasticsearch-platform/tsconfig.app.json"
      }
    },
    "indexer": {
      "type": "application",
      "root": "apps/indexer",
      "entryFile": "main",
      "sourceRoot": "apps/indexer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/indexer/tsconfig.app.json"
      }
    },
    "operations": {
      "type": "application",
      "root": "apps/operations",
      "entryFile": "main",
      "sourceRoot": "apps/operations/src",
      "compilerOptions": {
        "tsConfigPath": "apps/operations/tsconfig.app.json"
      }
    },
    "product-search": {
      "type": "library",
      "root": "libs/product-search",
      "entryFile": "index",
      "sourceRoot": "libs/product-search/src",
      "compilerOptions": {
        "tsConfigPath": "libs/product-search/tsconfig.lib.json"
      }
    },
    "search-index": {
      "type": "library",
      "root": "libs/search-index",
      "entryFile": "index",
      "sourceRoot": "libs/search-index/src",
      "compilerOptions": {
        "tsConfigPath": "libs/search-index/tsconfig.lib.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    }
  }
}