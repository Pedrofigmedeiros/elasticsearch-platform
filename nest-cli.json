{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/elasticsearch-platform/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/elasticsearch-platform/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/elasticsearch-platform",
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json"
      }
    },
    "config": {
      "type": "library",
      "root": "libs/config",
      "entryFile": "index",
      "sourceRoot": "libs/config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/config/tsconfig.lib.json"
      }
    },
    "elastic": {
      "type": "library",
      "root": "libs/elastic",
      "entryFile": "index",
      "sourceRoot": "libs/elastic/src",
      "compilerOptions": {
        "tsConfigPath": "libs/elastic/tsconfig.lib.json"
      }
    },
    "operations": {
      "type": "application",
      "root": "apps/operations",
      "entryFile": "main",
      "sourceRoot": "apps/operations/src",
      "compilerOptions": {
        "tsConfigPath": "apps/operations/tsconfig.app.json"
      }
    },
    "jobs-search": {
      "type": "library",
      "root": "libs/jobs-search",
      "entryFile": "index",
      "sourceRoot": "libs/jobs-search/src",
      "compilerOptions": {
        "tsConfigPath": "libs/jobs-search/tsconfig.lib.json"
      }
    }
  }
}