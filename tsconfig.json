{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@app/typescript": [
        "libs/typescript/src"
      ],
      "@app/typescript/*": [
        "libs/typescript/src/*"
      ],
      "libs/config": [
        "libs/config/src"
      ],
      "libs/config/*": [
        "libs/config/src/*"
      ],
      "libs/elastic": [
        "libs/elastic/src"
      ],
      "libs/elastic/*": [
        "libs/elastic/src/*"
      ],
      "libs/jobs-search": [
        "libs/jobs-search/src"
      ],
      "libs/jobs-search/*": [
        "libs/jobs-search/src/*"
      ]
    }
  }
}