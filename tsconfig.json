{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "libs/config": [
        "libs/config/src"
      ],
      "libs/config/*": [
        "libs/config/src/*"
      ],
      "libs/elasticsearch": [
        "libs/elasticsearch/src"
      ],
      "libs/elasticsearch/*": [
        "libs/elasticsearch/src/*"
      ],
      "libs/product-search": [
        "libs/product-search/src"
      ],
      "libs/product-search/*": [
        "libs/product-search/src/*"
      ],
      "libs/shared": [
        "libs/shared/src"
      ],
      "libs/shared/*": [
        "libs/shared/src/*"
      ]
    }
  }
}